<div class="modal fade" id="modal-order-creation" tabindex="-1" role="dialog" data-ajax-url="{{ path('admin_order_creation_ajax_create') }}">
    <div class="modal-dialog modal-lg" role="document" style="width: 90%; min-width: 1000px; max-width: 1500px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-loader">
                <br/><br/><div class="text-center"><span class="loading">{{ 'Please wait, loading'|trans({}, 'adminordercreation.bo.default') }}</span></div><br/><br/>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-error d-none">
                <div class="alert alert-danger">
                    <strong>{{ 'An error has occurred !!!'|trans({}, 'adminordercreation.bo.default') }}</strong>
                    <br/>
                    <span>{{ 'Message status :'|trans({}, 'adminordercreation.bo.default') }} <span class="textStatus"></span></span>
                    <br/>
                    <span>{{ 'Message content :'|trans({}, 'adminordercreation.bo.default') }}</span>
                    <br/>
                    <iframe width="100%" style="height: 400px;"></iframe>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans({}, 'adminordercreation.bo.default') }}</button>
                </div>
            </div>
        </div>
    </div>
</div>

{# Blank product-line scaffold cloned client-side by the module JS (the [] placeholders are rewritten to [N] per added row). #}
<script type="text/html" id="template-order-creation-product-line">
    <tr>
        <td>
            <div class="mb-3">
                <select class="form-control js-select-product" name="admin-order-creation-create[product_id][]" data-placeholder="{{ 'Search...'|trans({}, 'adminordercreation.bo.default') }}" data-url="{{ path('admin_order_creation_ajax_product') }}"></select>
            </div>
            <div class="mb-3">
                <select class="form-control js-select-product-sale-element" name="admin-order-creation-create[product_sale_element_id][]"></select>
            </div>
        </td>
        <td>
            <div class="mb-3">
                <div class="input-group">
                    <input class="form-control js-product-price-without-tax" data-url="{{ path('admin.product.calculate-raw-price', {action: 'to_tax'}) }}" type="number" min="0" step="0.000001" name="admin-order-creation-create[product_price_without_tax][]" value="0" />
                    <span class="input-group-text">HT</span>
                </div>
            </div>
            <div class="mb-3">
                <div class="input-group">
                    <input class="form-control js-product-price-with-tax" data-url="{{ path('admin.product.calculate-raw-price', {action: 'from_tax'}) }}" type="number" min="0" step="0.000001" name="admin-order-creation-create[product_price_with_tax][]" value="0" />
                    <span class="input-group-text">TTC</span>
                </div>
            </div>
            <input class="js-refresh-price" type="hidden" name="admin-order-creation-create[refresh_price][]" value="0" />
        </td>
        <td>
            <div class="mb-3">
                <input class="form-control js-action-refresh" type="number" min="1" step="1" name="admin-order-creation-create[product_quantity][]" value="1" />
            </div>
        </td>
        <td></td>
        <td>
            <button class="btn btn-danger js-action-delete" title="{{ 'Delete'|trans({}, 'adminordercreation.bo.default') }}">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
</script>

{# The default-twig BO ships no jQuery; this module's 464-line script.js (select2 AJAX modal driver) is loaded with its jQuery + select2 deps from CDN. A full vanilla/Stimulus port is deferred. #}
<link href="//cdnjs.cloudflare.com/ajax/libs/select2/4.0.2/css/select2.min.css" rel="stylesheet" />
<script type="text/javascript" src="//code.jquery.com/jquery-3.7.1.min.js"></script>
<script type="text/javascript" src="//cdnjs.cloudflare.com/ajax/libs/select2/4.0.2/js/select2.min.js"></script>
<script src="/modules/AdminOrderCreation/admin-order-creation/assets/js/script.js"></script>
<style>
    .js-list {
        width: 100% !important;
    }
    .js-animate-info-button {
        animation: AnimateInfoButton 2s infinite;
    }
    @keyframes AnimateInfoButton{
        0%{opacity: 1;}
        50%{opacity: 0;}
        100%{opacity: 1;}
    }
</style>
